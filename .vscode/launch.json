    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 启动程序",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        },
        {
            "name": "Python 调试程序",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_debug.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        }
    ]
}
