msgid ""
"运行前必须先在游戏内开启全局自动战斗\n"
"（设置 → 其他 → 自动战斗设置），开启后勾选本项"
msgstr ""
"You must enable global auto-battle in the game first\n"
"(Settings -> Other -> Auto-Battle Settings), then tick this box"

msgid ""
"活动自律中当前大活动的名称\n"
"例：铸碑者的黎明"
msgstr ""
"Name of the current large event, used to locate its chapter stages\n"
"Only works on a Chinese client: chapter matching looks for Chinese markers, so an English client falls back to the generic Supply stage instead"

msgid ""
"使用账户密码方式登录网页社区时(不是直接的手机号或邮箱)\n"
" account 请求负载中的 account_name 的值"
msgstr ""
"When signing in to the web community with an account and password (not a phone number or email),\n"
"this is the account_name value from the account request payload"

msgid ""
"使用账户密码方式登录网页社区时(不是直接的密码)\n"
" account 请求负载中的 passwd 的值"
msgstr ""
"When signing in to the web community with an account and password (not the password itself),\n"
"this is the passwd value from the account request payload"

msgid ""
"活动层喝水动作的按键时长，格式：a键时长-w键时长-d键时长\n"
"例：1.087-1.4-0.5"
msgstr ""
"How long to hold each key while walking across the Crew Deck to the coffee machine\n"
"Format: seconds holding A-W-D, e.g. 1.087-1.4-0.5"

msgid ""
"活动层吃饭动作的按键时长，格式：时长（秒）\n"
"例：1.0"
msgstr ""
"How long to hold the key while walking across the Crew Deck to the kitchen\n"
"Format: seconds holding S, e.g. 1.0"

msgid "自动完成社区每日任务（需填写用户名和密码）"
msgstr ""
"Completes the web community daily tasks (needs a username and password)"

msgid "自动领取邮件中的所有奖励"
msgstr "Claims every attachment in your mailbox"

msgid "自动领取活动页面中的情报补给奖励"
msgstr "Claims the rewards from the Event reward track"

msgid "自动完成活动页面中的闪耀星愿关卡"
msgstr "Completes the bonus stages on the Event page"

msgid ""
"自动进入限时开启活动并挑战物资关卡\n"
"关卡名称在\"当前物资关卡名称\"中配置"
msgstr ""
"Enters the current Time-Limited Event and runs its Supply stage\n"
"The event name is set in \"Current event name\""

msgid "自动完成活动层中的喝水、吃饭和奖励领取流程"
msgstr "Runs Tea Time, Delicious Cuisine, and reward pickup on the Crew Deck"

msgid "自动完成公共区委托的派遣与领取"
msgstr "Sends out and collects Dispatch Room assignments"

msgid ""
"开启后公共区将启动游戏内自主循环模式\n"
"同时跳过：体力本、自动刷体力、刷钱本、竞技场"
msgstr ""
"Uses the game's own auto-loop mode from the Crew Deck\n"
"Also skips: Supply Mission, Auto-Farm Intelligence Puzzle, Standardizing Sync, Combat Exercises"

msgid "自动购买商城中的免费礼包"
msgstr "Claims the free packs in the Shop"

msgid ""
"自动在各商店（家具/班组/调度/讯段/心智/人形堆栈）中\n"
"一键购买心愿单商品"
msgstr ""
"Buys your Wishlist items in each shop\n"
"(Furniture Shop / Platoon Shop / Dispatch Shop / Battlelog Trading / Neural Integration / Growth Stack)"

msgid "需开启班组项"
msgstr "Requires the Platoon option to be enabled"

msgid "自动领取委托中的每日任务奖励"
msgstr "Claims the daily task rewards from Commissions"

msgid "自动领取巡录（大月卡）的每日沿途行动奖励"
msgstr "Claims the daily progress rewards from Voyage, the monthly pass"

msgid "自动领取边界推进探索区域的采集与派遣奖励"
msgstr "Claims the gathering and dispatch rewards from Boundary Push"

msgid ""
"普通OCR：不做任何图像预处理，直接识别关卡名称\n"
"适用场景：背景和关卡卡片颜色与白色差异明显，文字清晰可辨"
msgstr ""
"Plain OCR: reads stage names with no image preprocessing\n"
"Best when the background and stage cards contrast clearly against white and the text is easy to read"

msgid ""
"除杂色OCR1（标准白色）：过滤掉非纯白色区域后再识别\n"
"适用场景：关卡卡片文字为标准白色，背景较复杂干扰识别"
msgstr ""
"Color filter 1 (strict white): filters out everything that is not pure white before reading\n"
"Best when the stage card text is standard white and a busy background is interfering"

msgid ""
"除杂色OCR2（宽松白灰色）：同时保留白色与浅灰色区域后再识别\n"
"适用场景：关卡卡片文字为白色或浅灰色，或普通OCR/除杂色OCR1均无法识别时"
msgstr ""
"Color filter 2 (loose white and gray): keeps white and light gray areas before reading\n"
"Best when the stage card text is white or light gray, or when neither Plain OCR nor Color filter 1 can read it"

msgid "开启自主循环后会跳过该项"
msgstr "Skipped when Start Loop is enabled"
